DATABASE_URL=postgresql://postgres:password@localhost:5432/songform
PORT=3001
CORS_ORIGIN=http://your-domain.com
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here

# SMTP 이메일 설정 (비밀번호 찾기 기능)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
